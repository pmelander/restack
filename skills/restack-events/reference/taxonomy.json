    "action": {
      "weights": {
        "announces": 2,
        "imposes": 2,
        "withdraws from": 2,
        "disputes": 2,
        "escalates": 2,
        "confirms": 1,
        "denies": 1,
        "postpones": 2,
        "collapses": 1,
        "expands": 2
      }
    },
    "magnitude": {
      "weights": {
        "negligible": 1,
        "minor": 2,
        "moderate": 3,
        "major": 3,
        "severe": 2
