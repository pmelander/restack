#!/bin/sh
# ReStack setup — install or update the skills for Claude Code.
#
# Copies (or symlinks) every skills/restack-*/ directory into the Claude Code
# skills directory, removes ReStack skills that no longer exist upstream, and
# records where the install came from so /restack-upgrade can find it later.
# Only an install into the default skills directory is recorded; a --target run
# leaves the record alone (ADR-011, Notes).
#
# POSIX sh. No dependencies. Safe to re-run.
#
# SAFETY: this script only ever creates, replaces or removes directories whose
# names begin with "restack-". Nothing else in the skills directory is touched,
# so it cannot damage another skill suite — the failure mode that ADR-009 exists
# to prevent.

set -eu

REPO_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
VERSION=$(cat "$REPO_DIR/VERSION" 2>/dev/null || echo "unknown")
DEFAULT_SKILLS_DIR="${CLAUDE_SKILLS_DIR:-$HOME/.claude/skills}"
SKILLS_DIR="$DEFAULT_SKILLS_DIR"
STATE_DIR="$HOME/.restack"

METHOD="copy"
DRY_RUN=""
QUIET=""

usage() {
  cat <<EOF
ReStack setup — install the skills for Claude Code

Usage: ./setup [options]

Options:
  --symlink     Symlink instead of copying, so repository edits are live.
                Use while developing ReStack itself. Needs a shell that can
                create symlinks; on Git Bash/Windows that means Developer Mode,
                an elevated shell, or MSYS=winsymlinks:nativestrict. If it
                cannot, setup says so and installs by copy instead.
  --copy        Copy the skills (default).
  --dry-run     Show what would change; write nothing.
  --target DIR  Install into DIR instead of \$HOME/.claude/skills, once.
                Not recorded in ~/.restack/install.json, so /restack-upgrade
                keeps tracking the default install. For a permanent install
                elsewhere, use CLAUDE_SKILLS_DIR instead.
  -q, --quiet   Only print the summary.
  -h, --help    Show this help.

Environment:
  CLAUDE_SKILLS_DIR   Overrides the default skills directory. An install there
                      is recorded, like one into \$HOME/.claude/skills.

Re-running is safe: it updates what changed and reports what it did.
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    --symlink) METHOD="symlink" ;;
    --copy)    METHOD="copy" ;;
    --dry-run) DRY_RUN="yes" ;;
    --quiet|-q) QUIET="yes" ;;
    --target)  shift; [ $# -gt 0 ] || { echo "--target needs a directory" >&2; exit 2; }; SKILLS_DIR="$1" ;;
    --help|-h) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

say() { [ -n "$QUIET" ] || printf '%s\n' "$*"; }

# --- sanity ------------------------------------------------------------------

[ -d "$REPO_DIR/skills" ] || {
  echo "Error: no skills/ directory next to this script ($REPO_DIR)." >&2
  echo "Run ./setup from a ReStack checkout." >&2
  exit 1
}

set -- "$REPO_DIR"/skills/restack-*/
[ -d "$1" ] || { echo "Error: no skills/restack-*/ directories found." >&2; exit 1; }

# Refuse to install a skill that is missing its SKILL.md — Claude Code would
# silently ignore it and the user would wonder why a command does not exist.
for src in "$REPO_DIR"/skills/restack-*/; do
  [ -f "$src/SKILL.md" ] || {
    echo "Error: $(basename "$src") has no SKILL.md — refusing to install a broken tree." >&2
    echo "If you are developing, run: python scripts/gen_skills.py" >&2
    exit 1
  }
done

[ -n "$DRY_RUN" ] || mkdir -p "$SKILLS_DIR"

# --- is this the install the record describes? -------------------------------
# install.json describes one install: the one a bare ./setup maintains, because
# that is what /restack-upgrade re-runs. A --target run into a scratch directory
# used to overwrite it, and /restack-upgrade then verified the scratch tree.
# -ef matches one directory however it is spelled - relative, trailing slash,
# or, on Windows, different case, which `pwd -P` does not normalise. It needs
# the directory to exist, so a dry run of a fresh install falls back to the
# string, less one trailing slash. Either way a miss errs toward leaving the
# record alone.

RECORD=""
if [ "${SKILLS_DIR%/}" = "${DEFAULT_SKILLS_DIR%/}" ] || [ "$SKILLS_DIR" -ef "$DEFAULT_SKILLS_DIR" ]; then
  RECORD="yes"
fi

# --- can this shell actually create symlinks? --------------------------------
# MSYS/Git Bash on Windows silently COPIES when `ln -s` is used without
# winsymlinks enabled: the command succeeds, the exit status is 0, and you get a
# directory. Reporting "symlinked, edits are live" after that is a false promise
# and worse than failing, because the user then edits the repository and watches
# nothing happen. Probe once, up front, and degrade honestly.

SYMLINK_DEGRADED=""
if [ "$METHOD" = "symlink" ]; then
  if [ -n "$DRY_RUN" ]; then
    SYMLINK_UNVERIFIED="yes"
  else
    _probe="$SKILLS_DIR/.restack-symlink-probe"
    rm -rf "$_probe"
    if ln -s "$REPO_DIR" "$_probe" 2>/dev/null && [ -L "$_probe" ]; then
      rm -f "$_probe"
    else
      rm -rf "$_probe"
      METHOD="copy"
      SYMLINK_DEGRADED="yes"
      _degraded_note="yes"
    fi
  fi
fi

say "ReStack v$VERSION"
say "  from: $REPO_DIR"
say "  into: $SKILLS_DIR  ($METHOD)"
[ -n "${_degraded_note:-}" ] && say "        (--symlink requested; this shell cannot create symlinks)"
[ -n "$DRY_RUN" ] && say "  DRY RUN — nothing will be written"
say ""

# --- install -----------------------------------------------------------------

n_new=0; n_upd=0; n_same=0; n_del=0

for src in "$REPO_DIR"/skills/restack-*/; do
  name=$(basename "$src")
  dest="$SKILLS_DIR/$name"

  if [ ! -e "$dest" ] && [ ! -L "$dest" ]; then
    action="install"; n_new=$((n_new + 1))
  elif [ "$METHOD" = "symlink" ] && [ -L "$dest" ] && [ "$(readlink "$dest")" = "${src%/}" ]; then
    action="unchanged"; n_same=$((n_same + 1))
  # The whole directory, not just SKILL.md: a section edited on its own would
  # otherwise never reach a copy install.
  elif [ "$METHOD" = "copy" ] && [ ! -L "$dest" ] && diff -r "${src%/}" "$dest" >/dev/null 2>&1; then
    action="unchanged"; n_same=$((n_same + 1))
  else
    action="update"; n_upd=$((n_upd + 1))
  fi

  [ "$action" = "unchanged" ] || say "  $action  /$name"

  [ -n "$DRY_RUN" ] && continue
  [ "$action" = "unchanged" ] && continue

  rm -rf "$dest"
  if [ "$METHOD" = "symlink" ]; then
    # The probe above proved symlinks work here, but verify each one anyway —
    # a silently-degraded link is the whole bug this guards against.
    ln -s "${src%/}" "$dest"
    [ -L "$dest" ] || {
      echo "Error: symlink for $name did not take (got a $(test -d "$dest" && echo directory || echo file))." >&2
      echo "Re-run with --copy." >&2
      exit 1
    }
  else
    cp -R "${src%/}" "$dest"
  fi
done

# --- remove skills deleted upstream -----------------------------------------
# The reason `cp -R skills/* ~/.claude/skills/` is not good enough: a skill
# removed or renamed upstream stays installed forever, and the user keeps
# invoking a command that no longer exists in the project.

for dest in "$SKILLS_DIR"/restack-*/; do
  [ -d "$dest" ] || continue
  name=$(basename "$dest")
  case "$name" in restack-\*) continue ;; esac      # unexpanded glob
  [ -d "$REPO_DIR/skills/$name" ] && continue
  say "  remove   /$name  (no longer in ReStack)"
  n_del=$((n_del + 1))
  [ -n "$DRY_RUN" ] || rm -rf "$dest"
done

# --- verify every section path resolves --------------------------------------
# A skill names its sections as <base>/sections/<file>. If one is missing from
# the install, the step that reads it silently does not run - which is how the
# outside opinion went missing for every copy install. Check the tree that was
# actually installed (the source tree in a dry run), and fail loudly.

missing=0
for skill in "$REPO_DIR"/skills/restack-*/; do
  name=$(basename "$skill")
  root="$SKILLS_DIR/$name"
  [ -n "$DRY_RUN" ] && root="${skill%/}"
  [ -f "$root/SKILL.md" ] || continue
  for rel in $(grep -o '<base>/sections/[A-Za-z0-9_.-]*\.md' "$root/SKILL.md" | sort -u); do
    file="$root/${rel#<base>/}"
    [ -f "$file" ] && continue
    echo "Error: /$name names ${rel} but $file is missing." >&2
    missing=$((missing + 1))
  done
done
if [ "$missing" -gt 0 ]; then
  echo "$missing section file(s) missing - the install is incomplete. Re-run ./setup; if it persists, report it." >&2
  exit 1
fi

# --- record the install ------------------------------------------------------
# Recorded under the default's own spelling, so the file reads the same however
# --target named it.
#
# Every value goes through json_str. Written raw, CLAUDE_SKILLS_DIR=C:\Users\...
# recorded an invalid \U escape, and the update check (ADR-016) read the whole
# file as unreadable and stayed silent. setup.ps1 gets this from ConvertTo-Json.

json_str() {
  printf '"%s"' "$(printf '%s' "$1" | sed 's/[\\"]/\\&/g')"
}

record_note=""
if [ -z "$RECORD" ]; then
  record_note="$STATE_DIR/install.json left unchanged - $SKILLS_DIR is not the default skills directory ($DEFAULT_SKILLS_DIR), and the record tracks only that one, because it is what /restack-upgrade re-installs. For a permanent install elsewhere, use CLAUDE_SKILLS_DIR=$SKILLS_DIR instead of --target."
elif [ -z "$DRY_RUN" ]; then
  mkdir -p "$STATE_DIR"
  cat > "$STATE_DIR/install.json" <<EOF
{
  "version": $(json_str "$VERSION"),
  "repo": $(json_str "$REPO_DIR"),
  "skills_dir": $(json_str "$DEFAULT_SKILLS_DIR"),
  "method": $(json_str "$METHOD"),
  "installed_at": $(json_str "$(date -u +%Y-%m-%dT%H:%M:%SZ)")
}
EOF
fi

# --- optional dependency check ----------------------------------------------

py=""
for candidate in python3 python; do
  command -v "$candidate" >/dev/null 2>&1 && { py="$candidate"; break; }
done

dep_note=""
codex_note=""
# Codex is optional. Without it the outside opinion falls back to a same-family
# subagent, which shares blind spots - worth saying, since the fallback looks
# identical from the outside.
if ! command -v codex >/dev/null 2>&1; then
  codex_note="Codex CLI not found - the outside opinion falls back to a same-family subagent (weaker; shares blind spots). Optional: npm i -g @openai/codex && codex login"
fi

if [ -z "$py" ]; then
  dep_note="Python not found — /restack-excel will not work. Everything else is unaffected."
elif ! "$py" -c "import openpyxl" >/dev/null 2>&1; then
  dep_note="openpyxl not installed — /restack-excel cannot read .xlsx (CSV still works). Fix: pip install -r requirements.txt"
fi

# --- summary -----------------------------------------------------------------

say ""
if [ $((n_new + n_upd + n_del)) -eq 0 ]; then
  printf 'ReStack v%s — already up to date (%d skills).\n' "$VERSION" "$n_same"
else
  printf 'ReStack v%s — %d installed, %d updated, %d removed, %d unchanged.\n' \
    "$VERSION" "$n_new" "$n_upd" "$n_del" "$n_same"
fi

[ -n "$record_note" ] && printf '\nNote: %s\n' "$record_note"
[ -n "$dep_note" ] && printf '\nNote: %s\n' "$dep_note"
[ -n "$codex_note" ] && printf '\nNote: %s\n' "$codex_note"

if [ -n "$SYMLINK_DEGRADED" ]; then
  cat <<EOF

Warning: --symlink was requested but this shell cannot create symlinks, so the
skills were INSTALLED BY COPY. Edits in the repository are NOT live — re-run
./setup after each change, or fix symlink support:

  Windows : enable Developer Mode (Settings > For developers), or run in an
            elevated shell, or:  export MSYS=winsymlinks:nativestrict
  Then    : ./setup --symlink
EOF
fi

if [ -n "$DRY_RUN" ]; then
  printf '\n(dry run — nothing was written)\n'
  # An if, not `[ ] && printf`: as the script's last command, a false test
  # would become its exit status, and every dry run without --symlink exited 1.
  if [ -n "${SYMLINK_UNVERIFIED:-}" ]; then
    printf 'Symlink support not probed in a dry run; a real run verifies it.\n'
  fi
else
  printf '\nType /restack in Claude Code to see the skills.\n'
  if [ "$METHOD" = "symlink" ]; then
    printf 'Symlinked: edits in %s are live after a regenerate.\n' "$REPO_DIR"
    printf 'Claude Code re-reads skills when they change; a fresh session is the sure way.\n'
  fi
fi
