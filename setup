#!/bin/sh
# ReStack setup — install or update the skills for Claude Code.
#
# Copies every skills/restack-*/ directory into $HOME/.claude/skills, removes
# ReStack skills that no longer exist upstream, and records the install in
# ~/.restack/install.json so /restack-upgrade can find it later.
#
# The install is always a copy in the user profile (ADR-019). It does not
# depend on this checkout: delete the checkout and the skills keep working.
# The checkout is only where the next upgrade copies from.
#
# POSIX sh. No dependencies. Safe to re-run.
#
# SAFETY: this script only ever creates, replaces or removes entries whose
# names begin with "restack-". Nothing else in the skills directory is touched,
# so it cannot damage another skill suite — the failure mode that ADR-009 exists
# to prevent. A link left by an older symlinked install is removed as a link,
# never followed: deleting through it would delete the checkout it points at.

set -eu

REPO_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
VERSION=$(cat "$REPO_DIR/VERSION" 2>/dev/null || echo "unknown")
SKILLS_DIR="$HOME/.claude/skills"
STATE_DIR="$HOME/.restack"

DRY_RUN=""
QUIET=""

usage() {
  cat <<EOF
ReStack setup — install the skills for Claude Code

Usage: ./setup [options]

Installs a copy of every ReStack skill into \$HOME/.claude/skills. The copy
does not depend on this checkout.

Options:
  --dry-run     Show what would change; write nothing.
  -q, --quiet   Only print the summary.
  -h, --help    Show this help.

Re-running is safe: it updates what changed and reports what it did. After
editing the repository, regenerate and re-run ./setup to install the edits.
EOF
}

removed() {
  echo "Error: $1 was removed in ReStack 2.7.0. Skills always install as a copy" >&2
  echo "into \$HOME/.claude/skills, independent of this checkout (ADR-019)." >&2
  echo "Run ./setup with no options." >&2
  exit 2
}

while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY_RUN="yes" ;;
    --quiet|-q) QUIET="yes" ;;
    --copy) ;;                                    # the old default; harmless
    --symlink) removed "--symlink" ;;
    --target) removed "--target" ;;
    --help|-h) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

say() { [ -n "$QUIET" ] || printf '%s\n' "$*"; }

# --- sanity ------------------------------------------------------------------

[ -d "$REPO_DIR/skills" ] || {
  echo "Error: no skills/ directory next to this script ($REPO_DIR)." >&2
  echo "Run ./setup from a ReStack checkout." >&2
  exit 1
}

set -- "$REPO_DIR"/skills/restack-*/
[ -d "$1" ] || { echo "Error: no skills/restack-*/ directories found." >&2; exit 1; }

# Refuse to install a skill that is missing its SKILL.md — Claude Code would
# silently ignore it and the user would wonder why a command does not exist.
for src in "$REPO_DIR"/skills/restack-*/; do
  [ -f "$src/SKILL.md" ] || {
    echo "Error: $(basename "$src") has no SKILL.md — refusing to install a broken tree." >&2
    echo "If you are developing, run: python scripts/gen_skills.py" >&2
    exit 1
  }
done

# CLAUDE_SKILLS_DIR used to move the install. It no longer does; say so rather
# than install somewhere the architect did not expect.
skills_env_note=""
if [ -n "${CLAUDE_SKILLS_DIR:-}" ]; then
  skills_env_note="CLAUDE_SKILLS_DIR is set ($CLAUDE_SKILLS_DIR) and was ignored: since 2.7.0 ReStack always installs into $SKILLS_DIR."
fi

[ -n "$DRY_RUN" ] || mkdir -p "$SKILLS_DIR"

say "ReStack v$VERSION"
say "  from: $REPO_DIR"
say "  into: $SKILLS_DIR  (copy)"
[ -n "$DRY_RUN" ] && say "  DRY RUN — nothing will be written"
say ""

# Remove one installed entry. A link is unlinked with rm -f, which never
# recurses: `rm -rf link/` would empty the directory the link points at, and
# for an install made with the old --symlink that is the architect's checkout.
remove_entry() {
  if [ -L "$1" ]; then
    rm -f "$1"
  else
    rm -rf "$1"
  fi
}

# --- install -----------------------------------------------------------------

n_new=0; n_upd=0; n_same=0; n_del=0; n_unlinked=0

for src in "$REPO_DIR"/skills/restack-*/; do
  name=$(basename "$src")
  dest="$SKILLS_DIR/$name"

  if [ -L "$dest" ]; then
    # Left by a symlinked install from before 2.7.0. Replaced with a copy.
    action="update"; n_upd=$((n_upd + 1)); n_unlinked=$((n_unlinked + 1))
  elif [ ! -e "$dest" ]; then
    action="install"; n_new=$((n_new + 1))
  # The whole directory, not just SKILL.md: a section edited on its own would
  # otherwise never reach the install.
  elif diff -r "${src%/}" "$dest" >/dev/null 2>&1; then
    action="unchanged"; n_same=$((n_same + 1))
  else
    action="update"; n_upd=$((n_upd + 1))
  fi

  [ "$action" = "unchanged" ] || say "  $action  /$name"

  [ -n "$DRY_RUN" ] && continue
  [ "$action" = "unchanged" ] && continue

  if [ -e "$dest" ] || [ -L "$dest" ]; then
    remove_entry "$dest"
  fi
  cp -R "${src%/}" "$dest"
done

# --- remove skills deleted upstream -----------------------------------------
# The reason `cp -R skills/* ~/.claude/skills/` is not good enough: a skill
# removed or renamed upstream stays installed forever, and the user keeps
# invoking a command that no longer exists in the project. No trailing slash
# on the glob, so a link is seen as a link and removed as one.

for dest in "$SKILLS_DIR"/restack-*; do
  [ -e "$dest" ] || [ -L "$dest" ] || continue      # unexpanded glob
  name=$(basename "$dest")
  [ -d "$REPO_DIR/skills/$name" ] && continue
  say "  remove   /$name  (no longer in ReStack)"
  n_del=$((n_del + 1))
  [ -n "$DRY_RUN" ] || remove_entry "$dest"
done

# --- verify every section path resolves --------------------------------------
# A skill names its sections as <base>/sections/<file>. If one is missing from
# the install, the step that reads it silently does not run - which is how the
# outside opinion went missing for every copy install. Check the tree that was
# actually installed (the source tree in a dry run), and fail loudly.

missing=0
for skill in "$REPO_DIR"/skills/restack-*/; do
  name=$(basename "$skill")
  root="$SKILLS_DIR/$name"
  [ -n "$DRY_RUN" ] && root="${skill%/}"
  [ -f "$root/SKILL.md" ] || continue
  for rel in $(grep -o '<base>/sections/[A-Za-z0-9_.-]*\.md' "$root/SKILL.md" | sort -u); do
    file="$root/${rel#<base>/}"
    [ -f "$file" ] && continue
    echo "Error: /$name names ${rel} but $file is missing." >&2
    missing=$((missing + 1))
  done
done
if [ "$missing" -gt 0 ]; then
  echo "$missing section file(s) missing - the install is incomplete. Re-run ./setup; if it persists, report it." >&2
  exit 1
fi

# --- record the install ------------------------------------------------------
# `repo` is the checkout this install was copied from: where /restack-upgrade
# pulls next. The skills do not need it to exist.
#
# Every value goes through json_str. Written raw, a path such as C:\Users\...
# recorded an invalid \U escape, and the update check (ADR-016) read the whole
# file as unreadable and stayed silent. setup.ps1 gets this from ConvertTo-Json.

json_str() {
  printf '"%s"' "$(printf '%s' "$1" | sed 's/[\\"]/\\&/g')"
}

# `source` is where /restack-upgrade and the update check fetch releases from:
# this checkout's origin, or the project itself for a download. Read only when
# this directory is itself a checkout, so a ReStack copy vendored inside some
# other repository never records that repository's origin.
DEFAULT_SOURCE="https://github.com/pmelander/restack.git"
SOURCE=""
if [ -e "$REPO_DIR/.git" ]; then
  SOURCE=$(git -C "$REPO_DIR" remote get-url origin 2>/dev/null || true)
fi
[ -n "$SOURCE" ] || SOURCE="$DEFAULT_SOURCE"

if [ -z "$DRY_RUN" ]; then
  mkdir -p "$STATE_DIR"
  cat > "$STATE_DIR/install.json" <<EOF
{
  "version": $(json_str "$VERSION"),
  "source": $(json_str "$SOURCE"),
  "repo": $(json_str "$REPO_DIR"),
  "skills_dir": $(json_str "$SKILLS_DIR"),
  "method": "copy",
  "installed_at": $(json_str "$(date -u +%Y-%m-%dT%H:%M:%SZ)")
}
EOF
fi

# --- optional dependency check ----------------------------------------------

py=""
for candidate in python3 python; do
  command -v "$candidate" >/dev/null 2>&1 && { py="$candidate"; break; }
done

dep_note=""
codex_note=""
# Codex is optional. Without it the outside opinion falls back to a same-family
# subagent, which shares blind spots - worth saying, since the fallback looks
# identical from the outside.
if ! command -v codex >/dev/null 2>&1; then
  codex_note="Codex CLI not found - the outside opinion falls back to a same-family subagent (weaker; shares blind spots). Optional: npm i -g @openai/codex && codex login"
fi

if [ -z "$py" ]; then
  dep_note="Python not found — /restack-excel will not work. Everything else is unaffected."
elif ! "$py" -c "import openpyxl" >/dev/null 2>&1; then
  dep_note="openpyxl not installed — /restack-excel cannot read .xlsx (CSV still works). Fix: pip install -r requirements.txt"
fi

# --- summary -----------------------------------------------------------------

say ""
if [ $((n_new + n_upd + n_del)) -eq 0 ]; then
  printf 'ReStack v%s — already up to date (%d skills).\n' "$VERSION" "$n_same"
else
  printf 'ReStack v%s — %d installed, %d updated, %d removed, %d unchanged.\n' \
    "$VERSION" "$n_new" "$n_upd" "$n_del" "$n_same"
fi

if [ "$n_unlinked" -gt 0 ]; then
  printf '\nNote: %d symlink(s) from an older install %s replaced with copies. The links were\nremoved as links; the checkout they pointed at is untouched.\n' \
    "$n_unlinked" "$([ -n "$DRY_RUN" ] && echo would be || echo were)"
fi
[ -n "$skills_env_note" ] && printf '\nNote: %s\n' "$skills_env_note"
[ -n "$dep_note" ] && printf '\nNote: %s\n' "$dep_note"
[ -n "$codex_note" ] && printf '\nNote: %s\n' "$codex_note"

if [ -n "$DRY_RUN" ]; then
  printf '\n(dry run — nothing was written)\n'
else
  printf '\nType /restack in Claude Code to see the skills.\n'
  printf 'The install is a copy: it keeps working if %s is moved or deleted.\n' "$REPO_DIR"
fi
